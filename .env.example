# Copie para `.env.local` (nunca versionar credenciais).
# Desenvolvimento local (arquivo): não precisa de TURSO_AUTH_TOKEN.
TURSO_DATABASE_URL=file:./.data/local.db

# Turso remoto (produção / staging):
# TURSO_DATABASE_URL=libsql://<seu-db>.turso.io
# TURSO_AUTH_TOKEN=

# Better Auth (gere um segredo forte em produção: openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domínio raiz das vitrines (sem protocolo). Em local: localhost:3000
# Acesse loja.localhost:3000 após configurar subdomain da loja.
# ROOT_DOMAIN=localhost:3000
# Produção: ROOT_DOMAIN=mycars.com.br

# Seed só roda se NODE_ENV !== production E ALLOW_DB_SEED=true
ALLOW_DB_SEED=true

# Jobs internos (/api/internal/jobs) — Bearer token (mín. 16 chars)
# INTERNAL_JOBS_SECRET=change-me-jobs-secret

# --- Mídia (object storage) ---
# local = .data/media + /api/media (dev). r2 = Cloudflare R2 (produção).
# Se omitido: usa r2 quando as vars R2_* estiverem completas; senão local.
# MEDIA_STORAGE_DRIVER=local
# MEDIA_LOCAL_ROOT=.data/media

# Cloudflare R2 (S3-compatible). Chaves NUNCA no cliente.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=mycars-media
# URL pública do bucket (custom domain ou r2.dev)
# R2_PUBLIC_BASE_URL=https://media.exemplo.com

# --- Precificação FIPE (servidor) ---
# Token opcional Parallelum (X-Subscription-Token). Sem token: ~500 req/dia.
# FIPE_API_TOKEN=

